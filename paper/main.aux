\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Calibrated resolution and the sample that covers half of the corpus. $r_{\mathrm  {same}}$: distance at which half of the judged pairs are the same specific content, with a 90\% interval from resampling pairs within bins. $n$ (share): random sample after which half of the corpus lies within $r_{\mathrm  {same}}$ of a sampled document, measured on the whole corpus, as a count and a share of $N$ (at most 50\% by construction). pred.: share predicted by the law fitted inside one pilot. interval: measured share at the ends of the 90\% interval. $<$100: below the smallest sample. $\le $: crossing at the first bin; 32\% of resamples find none. Bluesky (passes) has no crossing, and 26\% and 34\% of resamples find one. Truth Social and Bluesky are samples of 50{,}000 posts, and their shares describe a corpus of that size.}}{8}{table.caption.3}\protected@file@percent }
\newlabel{tab:rcal}{{2}{8}{Calibrated resolution and the sample that covers half of the corpus. $r_{\mathrm {same}}$: distance at which half of the judged pairs are the same specific content, with a 90\% interval from resampling pairs within bins. $n$ (share): random sample after which half of the corpus lies within $r_{\mathrm {same}}$ of a sampled document, measured on the whole corpus, as a count and a share of $N$ (at most 50\% by construction). pred.: share predicted by the law fitted inside one pilot. interval: measured share at the ends of the 90\% interval. $<$100: below the smallest sample. $\le $: crossing at the first bin; 32\% of resamples find none. Bluesky (passes) has no crossing, and 26\% and 34\% of resamples find one. Truth Social and Bluesky are samples of 50{,}000 posts, and their shares describe a corpus of that size}{table.caption.3}{}}
