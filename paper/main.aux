\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Isolation rate $G$ against $n r^{d}$ on a log scale, one panel per corpus (GTR encoder for the forum corpora), colour by radius $r$, one draw per cell. Points from different radii fall on one curve where the law holds (the manifolds, AskDocs, TIFU) and separate where it fails (Trump, the Zipf mixture). The grey line is the fit of Equation~\ref {eq:collapse} on cells with $n \le 1{,}000$; the annotation gives $d$ and the full out of sample $R^2$ of Table~\ref {tab:collapse}.}}{7}{figure.caption.2}\protected@file@percent }
\newlabel{fig:collapse}{{1}{7}{Isolation rate $G$ against $n r^{d}$ on a log scale, one panel per corpus (GTR encoder for the forum corpora), colour by radius $r$, one draw per cell. Points from different radii fall on one curve where the law holds (the manifolds, AskDocs, TIFU) and separate where it fails (Trump, the Zipf mixture). The grey line is the fit of Equation~\ref {eq:collapse} on cells with $n \le 1{,}000$; the annotation gives $d$ and the full out of sample $R^2$ of Table~\ref {tab:collapse}}{figure.caption.2}{}}
